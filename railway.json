{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "echo 'badge service: no build step, Node runs the TypeScript directly'",
    "watchPatterns": ["server/**", "src/core/**", "site.config.ts", "package.json", "package-lock.json", ".node-version", "railway.json"]
  },
  "deploy": {
    "startCommand": "node --max-old-space-size=768 server/index.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}
