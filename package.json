{
  "name": "humanloads",
  "version": "0.0.0",
  "private": true,
  "description": "npm counts every tarball fetch. humanloads shows how much of it is noise.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "data": "node scripts/build-data.mjs",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "node --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/semver": "7.8.0",
    "semver": "7.8.6",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.2"
  }
}
